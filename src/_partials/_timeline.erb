<ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical lg:-ml-32 max-md: pl-0">
  <% timeline.each.with_index do |t, index| %>
    <li class="m-0" style="margin:0;">
      <hr>
      <div class="timeline-start text-lg"><%= t.period %></div>

      <div class="timeline-middle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path d="M232,128A104,104,0,1,1,128,24,104.13,104.13,0,0,1,232,128Z"></path></svg>
      </div>

      <div class="timeline-end timeline-box max-w-sm border-slate-200 mb-4">
        <div class="text-lg font-bold">
          <% if t.url.present? %>
            <a href="<%= t.url %>" class="flex link link-hover">
              <%= t.title %>
            </a>
          <% else %>
            <span><%= t.title %></span>
          <% end %>
        </div>
        <ul class="custom list-none" style="padding-left:0;margin:0;">
          <% t.description.each do |d| %>
            <li class="text-balance text-sm my-1" data-icon="> "><%= d %></li>
          <% end %>
        </ul>
      </div>
      <hr>
    </li>
  <% end %>
</ul>
