<a class="skip-link" href="#main">Skip to content</a>

<header class="band-raised sticky top-0 z-50">
  <div class="shell flex h-14 items-center justify-between gap-6">
    <a
      class="inline-block py-3.5 font-mono text-[12px] tracking-[0.05em] text-ink"
      href="<%= relative_url '/' %>"
    >
      <span class="hidden sm:inline">A. Christian Toscano</span>
      <span class="sm:hidden">ACT</span>
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-6">
        <% nav_items.each do |label, path| %>
          <li>
            <a
              class="inline-block py-3.5 font-mono text-[12px] tracking-[0.05em] transition-colors duration-150 <%= nav_active?(path) ? 'text-ink' : 'text-ink-3 hover:text-ink' %>"
              href="<%= relative_url path %>"
              <% if nav_active?(path) %>aria-current="page"<% end %>
            ><%= label %></a>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
